# ─────────────────────────────────────────────────────────────
# Backend (Go) — variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# ─────────────────────────────────────────────────────────────

# OPCIÓN A (recomendada en producción: Render + Neon)
# Cadena de conexión completa. Neon exige sslmode=require.
# DATABASE_URL=postgres://usuario:password@host.neon.tech/dbname?sslmode=require

# OPCIÓN B (desarrollo local sin DATABASE_URL): variables sueltas
DB_HOST=localhost
DB_PORT=5432
DB_USER=skilluser
DB_PASSWORD=skillpass
DB_NAME=skilldb

# Puerto del servidor. En Render NO lo definas (lo inyecta la plataforma).
PORT=8080

# Origen permitido para CORS.
# Local: "*"  |  Producción: https://tu-app.vercel.app
CORS_ALLOW_ORIGIN=*
